# =============================================================================
# Bolsa de Trabajo · variables de entorno
# Copiar a .env y completar:  cp .env.example .env
# NUNCA commitear .env (está en .gitignore). Valores de ejemplo = solo desarrollo.
# =============================================================================

# --- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=bolsa
ENVIRONMENT=development
TZ=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# --- Puertos expuestos en el host --------------------------------------------
GATEWAY_PORT=8080
N8N_PORT=5678
MAIL_UI_PORT=8025
# Solo en desarrollo (docker-compose.override.yml)
POSTGRES_HOST_PORT=5432

# --- PostgreSQL (una base, un schema y un rol por servicio) -------------------
POSTGRES_DB=bolsa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

AUTH_DB_PASSWORD=change-me-auth
PROFILE_DB_PASSWORD=change-me-profile
JOBS_DB_PASSWORD=change-me-jobs
MATCHING_DB_PASSWORD=change-me-matching
N8N_DB_PASSWORD=change-me-n8n

# --- Autenticación (auth-service · NestJS) -----------------------------------
# Claves RS256 en PEM. Generar con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt_private.pem
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem
# La carpeta secrets/ se monta solo-lectura en auth-service y está en .gitignore.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt/jwt_public.pem
JWT_KEY_ID=bolsa-auth-1
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=bolsa-auth
JWT_AUDIENCE=bolsa-api
PASSWORD_RESET_TTL=1h

# --- Comunicación entre servicios --------------------------------------------
# Token compartido para llamadas internas (header X-Service-Token).
# Generar con: openssl rand -hex 32
SERVICE_TOKEN=change-me-service-token

# --- Correo (Mailpit en desarrollo) ------------------------------------------
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_FROM=no-reply@bolsa.local
FRONTEND_URL=http://localhost:8080

# --- Eventos de cuenta (auth-service → servicios) -----------------------------
# URLs separadas por coma que reciben account.deleted / account.updated
# con X-Service-Token (ver contracts/account_events.md). Sin definir = profile-service y
# jobs-service por la red interna (default de docker-compose.yml). Vacía = no avisa a nadie.
# ACCOUNT_EVENT_WEBHOOKS=http://profile-service:8000/api/v1/profiles/internal/account-events,http://jobs-service:8000/api/v1/jobs/internal/account-events
# Reintentos del outbox de eventos (ms): cada cuánto revisa la cola, primer reintento y tope.
# ACCOUNT_EVENT_RETRY_INTERVAL_MS=5000
# ACCOUNT_EVENT_RETRY_BASE_MS=5000
# ACCOUNT_EVENT_RETRY_MAX_MS=600000

# --- CVs ---------------------------------------------------------------------
CV_STORAGE_PATH=/data/cvs
CV_MAX_SIZE_MB=5
# profile-service: carga 15 perfiles ficticios (stu-001…stu-015) para probar matching
PROFILE_SEED_DEMO=true
# jobs-service: carga 12 ofertas ficticias (job-001…job-012) si la base está vacía
JOBS_SEED_DEMO=true

# --- n8n (Orquestación y ejecución de agentes IA) ----------------------------
# Generar con: openssl rand -hex 24  (no cambiar después de crear credenciales)
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Token compartido de los webhooks de n8n (header X-Webhook-Token). openssl rand -hex 32
N8N_WEBHOOK_TOKEN=change-me-n8n-webhook-token

# --- Agentes (los lee mcp-tools → herramienta get_agent_settings) ------------
# Fuente de configuración: env (hoy) | panel (futuro panel de configuración)
AGENT_SETTINGS_SOURCE=env
# La API key de NVIDIA es la credencial "OpenAI account" de n8n
# (Base URL https://integrate.api.nvidia.com/v1). Dos opciones:
#   - crearla a mano en la UI de n8n (queda guardada en el volumen bolsa_pg_data), o
#   - completar NVIDIA_API_KEY (sólo en .env, nunca en el repo): n8n-init la crea
#     o actualiza en cada arranque. Vacía = no toca la credencial existente.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Modelos en orden de preferencia (fallback), separados por coma
AGENT_MODELS=nvidia/nemotron-3-ultra-550b-a55b,deepseek-ai/deepseek-v4.1-flash,minimaxai/minimax-m3.1-flash
AGENT_MODELS_CV=nvidia/nemotron-3-ultra-550b-a55b,deepseek-ai/deepseek-v4.1-flash,minimaxai/minimax-m3.1-flash
AGENT_MODELS_VERIFIER=nvidia/nemotron-3-ultra-550b-a55b,deepseek-ai/deepseek-v4.1-flash
# Límites del router (cuenta NVIDIA ~40 pedidos/min)
NVIDIA_RPM_LIMIT=40
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_TEMPERATURE=0.2
# Reintentos del orquestador cuando el verificador rechaza
AGENT_MAX_VERIFY_RETRIES=1
# Recomendador
RECO_MAX_JOBS_PER_STUDENT=5
RECO_MAX_PROFILES_PER_JOB=10
RECO_MAX_ITEMS_PER_JOB=5
RECO_MIN_SCORE=0
# Notificaciones por mail (n8n WF-02 a WF-05): puntaje mínimo por reglas para avisar,
# tope de mails por evento y a quién avisar los errores de los workflows (vacío = nadie).
NOTIFY_ENABLED=true
NOTIFY_MIN_SCORE=70
NOTIFY_MAX_PER_EVENT=10
NOTIFY_ADMIN_EMAIL=admin@bolsa.local
# Extractor de CV
CV_ALLOWED_EXTENSIONS=pdf,docx,doc,md
CV_MAX_TEXT_CHARS=40000
# false = las herramientas MCP leen profile-service, jobs-service y matching-service
# reales. true = datos ficticios (probar mcp-tools aislado).
# Tiene que coincidir con MATCHING_USE_MOCKS: WF-06 rankea por MCP los IDs que manda
# matching-service. Si tu .env viene de una versión anterior (las dos en true o
# MCP_USE_MOCKS=true), cambialas a false y recreá: docker compose up -d mcp-tools matching-service
MCP_USE_MOCKS=false

# ------------------------------------------------------- matching-service ---
# false = perfiles y ofertas reales (profile-service y jobs-service).
# true = pool ficticio de services/matching-service/app/data/mock (probar matching aislado)
MATCHING_USE_MOCKS=false
