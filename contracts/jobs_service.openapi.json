    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details"],
            "properties": {
              "code": {
                "type": "string",
                "examples": ["INVALID_INPUT", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "UPSTREAM_ERROR"]
              },
              "message": { "type": "string" },
              "details": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            }
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": ["active", "closed"],
        "description": "Estado de la oferta. `active` = publicada; `closed` = cerrada (no se borra)."
      },
      "JobStatusFilter": {
        "type": "string",
        "enum": ["active", "closed", "all"],
        "description": "Filtro de listado. `all` sólo para admin/service en /jobs y para la empresa dueña en /companies/me/searches."
      },
      "RequirementKind": {
        "type": "string",
        "enum": ["required", "desired", "excluding"],
        "description": "Tipo de requisito. Debe haber al menos una skill `required`."
      },
      "Seniority": {
        "type": "string",
        "enum": ["no_experience", "trainee", "junior", "semi_senior", "senior"]
      },
      "WorkSchedule": {
        "type": "string",
        "enum": ["full_time", "part_time", "hourly", "flexible"]
      },
      "WorkModality": {
        "type": "string",
        "enum": ["onsite", "remote", "hybrid"]
      },
      "EmploymentType": {
        "type": "string",
        "enum": ["employee", "freelance", "internship", "trainee"]
      },
      "ContractDuration": {
        "type": "string",
        "enum": ["permanent", "fixed_term", "project", "seasonal"]
      },
      "AvailabilityStart": {
        "type": "string",
        "enum": ["immediate", "within_15_days", "within_30_days", "to_agree"]
      },
      "Shift": {
        "type": "string",
        "enum": ["morning", "afternoon", "evening", "night", "weekend", "rotating"]
      },
      "SkillCategory": {
        "type": "string",
        "enum": ["hard", "soft", "tool", "methodology"]
      },
      "LanguageLevel": {
        "type": "string",
        "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "native"]
      },
      "EducationLevel": {
        "type": "string",
        "enum": ["secondary", "tertiary", "university", "postgraduate", "course"]
      },
      "EducationStatus": {
        "type": "string",
        "enum": ["in_progress", "completed", "incomplete"]
      },
      "Currency": {
        "type": "string",
        "enum": ["ARS", "USD"]
      },
      "SalaryPeriod": {
        "type": "string",
        "enum": ["hour", "day", "month", "year", "project"]
      },
      "SalaryVisibility": {
        "type": "string",
        "enum": ["public", "on_match", "hidden"],
        "description": "`public`: visible para todos. `on_match`/`hidden`: para estudiantes y otras empresas el servicio devuelve salary=null; la empresa dueña, admin y service token ven el valor completo."
      },
      "SalaryAdjustment": {
        "type": "string",
        "enum": ["none", "monthly", "quarterly", "semiannual", "by_agreement"]
      },
      "PaymentCurrencyMode": {
        "type": "string",
        "enum": ["local", "usd", "usd_paid_in_local"]
      },
      "TravelAvailability": {
        "type": "string",
        "enum": ["none", "occasional", "frequent"]
      },
      "InvoicingStatus": {
        "type": "string",
        "enum": ["monotributo", "responsable_inscripto", "none", "to_register"]
      },
      "Location": {
        "type": "object",
        "required": ["country", "province", "city"],
        "additionalProperties": false,
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alfa-2.",
            "examples": ["AR"]
          },
          "province": { "type": "string", "minLength": 1, "maxLength": 120 },
          "city": { "type": "string", "minLength": 1, "maxLength": 120 },
          "postal_code": { "type": ["string", "null"], "maxLength": 20 },
          "zone": { "type": ["string", "null"], "maxLength": 120 }
        }
      },
      "VariableCompensation": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["bonus", "commission", "profit_sharing"] },
          "description": { "type": "string", "maxLength": 500 },
          "max_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
        }
      },
      "SalaryRange": {
        "type": "object",
        "description": "Sueldo ofrecido. Si to_agree=true, min/max pueden faltar. Si hay monto, min es obligatorio y currency/period también. max >= min.",
        "additionalProperties": false,
        "properties": {
          "min": { "type": ["number", "null"], "minimum": 0 },
          "max": { "type": ["number", "null"], "minimum": 0 },
          "currency": {
            "anyOf": [{ "$ref": "#/components/schemas/Currency" }, { "type": "null" }]
          },
          "period": {
            "anyOf": [{ "$ref": "#/components/schemas/SalaryPeriod" }, { "type": "null" }]
          },
          "gross": { "type": "boolean", "default": true },
          "payment_mode": {
            "anyOf": [{ "$ref": "#/components/schemas/PaymentCurrencyMode" }, { "type": "null" }]
          },
          "negotiable": { "type": "boolean", "default": false },
          "adjustment": {
            "anyOf": [{ "$ref": "#/components/schemas/SalaryAdjustment" }, { "type": "null" }]
          },
          "variable_compensation": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VariableCompensation" },
            "default": []
          },
          "visibility": {
            "anyOf": [{ "$ref": "#/components/schemas/SalaryVisibility" }, { "type": "null" }]
          },
          "to_agree": { "type": "boolean", "default": false },
          "notes": { "type": ["string", "null"], "maxLength": 500 }
        }
      },
      "WeeklyHours": {
        "type": "object",
        "required": ["min", "max"],
        "additionalProperties": false,
        "properties": {
          "min": { "type": "integer", "minimum": 0, "maximum": 168 },
          "max": { "type": "integer", "minimum": 0, "maximum": 168 }
        }
      },
      "WorkConditions": {
        "type": "object",
        "additionalProperties": false,
        "description": "Lo que ofrece el puesto. Todos los campos son opcionales; salary puede ser null.",
        "properties": {
          "work_schedule": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WorkSchedule" },
            "default": []
          },
          "work_modality": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WorkModality" },
            "default": []
          },
          "hybrid_onsite_days": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 5
          },
          "employment_type": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmploymentType" },
            "default": []
          },
          "contract_duration": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ContractDuration" },
            "default": []
          },
          "weekly_hours": {
            "anyOf": [{ "$ref": "#/components/schemas/WeeklyHours" }, { "type": "null" }]
          },
          "shifts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Shift" },
            "default": []
          },
          "availability_start": {
            "anyOf": [{ "$ref": "#/components/schemas/AvailabilityStart" }, { "type": "null" }]
          },
          "salary": {
            "anyOf": [{ "$ref": "#/components/schemas/SalaryRange" }, { "type": "null" }]
          },
          "relocation_support": { "type": "boolean", "default": false },
          "travel_availability": {
            "anyOf": [{ "$ref": "#/components/schemas/TravelAvailability" }, { "type": "null" }]
          },
          "driver_license": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "own_vehicle": { "type": ["boolean", "null"] },
          "own_equipment": { "type": ["boolean", "null"] },
          "invoicing_status": {
            "anyOf": [{ "$ref": "#/components/schemas/InvoicingStatus" }, { "type": "null" }]
          },
          "work_authorization": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "default": []
          },
          "timezone": { "type": ["string", "null"], "maxLength": 64 },
          "timezone_overlap_hours": { "type": ["integer", "null"], "minimum": 0, "maximum": 24 }
        }
      },
      "CompanySnapshot": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "industry": { "type": ["string", "null"], "maxLength": 160 },
          "size": {
            "type": ["string", "null"],
            "enum": ["1-10", "11-50", "51-200", "201-1000", "1000+", null]
          },
          "logo_url": { "type": ["string", "null"], "format": "uri" }
        }
      },
      "SkillRequirement": {
        "type": "object",
        "required": ["name", "level", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "normalized": {
            "type": "string",
            "readOnly": true,
            "description": "Lo calcula el servicio: minúsculas, sin acentos y espacios simples. No se envía en el request."
          },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "kind": { "$ref": "#/components/schemas/RequirementKind" },
          "years": { "type": ["number", "null"], "minimum": 0 },
          "category": {
            "anyOf": [{ "$ref": "#/components/schemas/SkillCategory" }, { "type": "null" }]
          }
        }
      },
      "LanguageRequirement": {
        "type": "object",
        "required": ["name", "level", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "normalized": { "type": "string", "readOnly": true },
          "level": { "$ref": "#/components/schemas/LanguageLevel" },
          "kind": { "$ref": "#/components/schemas/RequirementKind" },
          "certification": { "type": ["string", "null"], "maxLength": 120 }
        }
      },
      "EducationRequirement": {
        "type": "object",
        "required": ["level", "status", "kind"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": ["string", "null"], "maxLength": 200 },
          "degree": { "type": ["string", "null"], "maxLength": 200 },
          "field": { "type": ["string", "null"], "maxLength": 120 },
          "level": { "$ref": "#/components/schemas/EducationLevel" },
          "status": { "$ref": "#/components/schemas/EducationStatus" },
          "progress_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "gpa": { "type": ["number", "null"], "minimum": 0 },
          "kind": { "$ref": "#/components/schemas/RequirementKind" }
        }
      },
      "ExperienceRequirement": {
        "type": "object",
        "required": ["min_years", "kind"],
        "additionalProperties": false,
        "properties": {
          "min_years": { "type": "number", "minimum": 0, "maximum": 60 },
          "area": { "type": ["string", "null"], "maxLength": 120 },
          "kind": { "$ref": "#/components/schemas/RequirementKind" }
        }
      },
      "CertificationRequirement": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "$ref": "#/components/schemas/RequirementKind" }
        }
      },
      "AcademicRequirement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min_progress_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "careers": { "type": "array", "items": { "type": "string" }, "default": [] },
          "min_current_year": { "type": ["integer", "null"], "minimum": 1, "maximum": 10 }
        }
      },
      "Requirements": {
        "type": "object",
        "required": ["skills"],
        "additionalProperties": false,
        "properties": {
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/SkillRequirement" }
          },
          "languages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LanguageRequirement" },
            "default": []
          },
          "education": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EducationRequirement" },
            "default": []
          },
          "experience": {
            "anyOf": [{ "$ref": "#/components/schemas/ExperienceRequirement" }, { "type": "null" }]
          },
          "certifications": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CertificationRequirement" },
            "default": []
          },
          "academic": {
            "anyOf": [{ "$ref": "#/components/schemas/AcademicRequirement" }, { "type": "null" }]
          }
        }
      },
      "JobCreate": {
        "type": "object",
        "required": ["title", "description", "seniority", "location", "requirements"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "responsibilities": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 },
            "maxItems": 50,
            "default": []
          },
          "area": { "type": "string", "maxLength": 120, "default": "" },
          "seniority": { "$ref": "#/components/schemas/Seniority" },
          "vacancies": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
          "location": { "$ref": "#/components/schemas/Location" },
          "work_conditions": {
            "anyOf": [{ "$ref": "#/components/schemas/WorkConditions" }, { "type": "null" }]
          },
          "requirements": { "$ref": "#/components/schemas/Requirements" },
          "benefits": {
            "type": "array",
            "items": { "type": "string", "maxLength": 200 },
            "maxItems": 50,
            "default": []
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Si viene, debe ser futuro."
          }
        }
      },
      "JobUpdate": {
        "type": "object",
        "additionalProperties": false,
        "description": "PATCH parcial. Los bloques enviados se reemplazan completos. No se aceptan company_id, company_snapshot, version ni timestamps. `status` sólo acepta `active` para reabrir una oferta cerrada.",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "responsibilities": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 },
            "maxItems": 50
          },
          "area": { "type": "string", "maxLength": 120 },
          "seniority": { "$ref": "#/components/schemas/Seniority" },
          "vacancies": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "location": { "$ref": "#/components/schemas/Location" },
          "work_conditions": {
            "anyOf": [{ "$ref": "#/components/schemas/WorkConditions" }, { "type": "null" }]
          },
          "requirements": { "$ref": "#/components/schemas/Requirements" },
          "benefits": {
            "type": "array",
            "items": { "type": "string", "maxLength": 200 },
            "maxItems": 50
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["active"],
            "description": "Sólo para reabrir una oferta closed. Para cerrar: DELETE /api/v1/jobs/{id}."
          }
        }
      },
      "JobOpportunity": {
        "type": "object",
        "required": [
          "id",
          "company_id",
          "company_snapshot",
          "status",
          "title",
          "description",
          "responsibilities",
          "area",
          "seniority",
          "vacancies",
          "location",
          "work_conditions",
          "requirements",
          "benefits",
          "created_at",
          "updated_at",
          "published_at",
          "expires_at",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "company_id": { "type": "string", "readOnly": true },
          "company_snapshot": { "$ref": "#/components/schemas/CompanySnapshot" },
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "area": { "type": "string" },
          "seniority": { "$ref": "#/components/schemas/Seniority" },
          "vacancies": { "type": "integer", "minimum": 1 },
          "location": { "$ref": "#/components/schemas/Location" },
          "work_conditions": { "$ref": "#/components/schemas/WorkConditions" },
          "requirements": { "$ref": "#/components/schemas/Requirements" },
          "benefits": { "type": "array", "items": { "type": "string" } },
          "created_at": { "type": "string", "format": "date-time", "readOnly": true },
          "updated_at": { "type": "string", "format": "date-time", "readOnly": true },
          "published_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "readOnly": true
          },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "version": { "type": "integer", "minimum": 1, "readOnly": true }
        }
      },
      "JobList": {
        "type": "object",
        "required": ["items", "total", "page", "size", "pages"],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobOpportunity" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "size": { "type": "integer", "minimum": 1, "maximum": 200 },
          "pages": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
