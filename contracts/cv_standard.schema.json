{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bolsa.local/schemas/cv_standard.schema.json",
  "title": "CV Estandarizado (Sugerencias extraídas por IA sin nulos)",
  "type": "object",
  "required": [
    "personal",
    "summary",
    "skills",
    "experience",
    "education",
    "languages",
    "certifications",
    "links"
  ],
  "additionalProperties": true,
  "properties": {
    "personal": {
      "type": "object",
      "required": ["name", "email", "phone", "location"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "summary": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "level": {
            "oneOf": [
              { "type": "integer", "minimum": 1, "maximum": 5 },
              { "type": "string" }
            ]
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "role", "start", "end", "description"],
        "additionalProperties": true,
        "properties": {
          "company": { "type": "string" },
          "role": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "degree", "status", "start", "end"],
        "additionalProperties": true,
        "properties": {
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "status": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "level": { "type": "string" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "links": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_manual_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "origin": { "type": "string", "const": "AI" },
    "model": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "disclaimer": { "type": "string", "minLength": 1 }
  }
}
