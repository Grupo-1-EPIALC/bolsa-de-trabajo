{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bolsa.local/schemas/student_recommendations.schema.json",
  "title": "Qué competencias sumar o mejorar, en general (Training Advisor, origin=AI)",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "type",
          "skill",
          "text",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "course",
              "skill",
              "profile_tip"
            ]
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 5
          },
          "priority": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600
    }
  },
  "description": "Salida del agente training_advisor. Es general (sobre las ofertas más parecidas al perfil), no por oferta. No incluye score ni pide portfolios o proyectos."
}
