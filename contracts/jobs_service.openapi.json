{
  "openapi": "3.1.0",
  "info": {
    "title": "jobs-service",
    "version": "0.1.0",
    "description": "Ofertas de trabajo y búsquedas de empresas. Implementa RF-11, RF-12, HU-11, HU-12, UT-JOBS-01 y UT-JOBS-02 del Plan MVP. Autenticación de usuarios con Authorization: Bearer <JWT RS256 de auth-service> validado contra el JWKS; servicios internos (matching-service, mcp-tools, n8n) con X-Service-Token. El gateway borra X-Service-Token en peticiones externas. Errores: {\"error\": {\"code\", \"message\", \"details\"}}. Documentación para el front: contracts/jobs_frontend.md. Documentación para matching/mcp: contracts/jobs_matching.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "API Gateway (same-origin para el front)"
    },
    {
      "url": "http://localhost:8000",
      "description": "jobs-service directo (sólo desarrollo/integración)"
    }
  ],
  "tags": [
    {
      "name": "jobs",
      "description": "Ofertas y búsquedas"
    },
    {
      "name": "companies",
      "description": "Vista de la empresa autenticada"
    },
    {
      "name": "infra",
      "description": "Salud del servicio"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["infra"],
        "summary": "Estado del servicio",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio sano",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service", "version"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "service": { "type": "string", "const": "jobs-service" },
                    "version": { "type": "string", "example": "0.1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "tags": ["jobs"],
        "summary": "Lista ofertas",
        "description": "Devuelve ofertas completas, paginadas. `student` y `company` sólo pueden pedir `status=active`; `admin` y el service token pueden pedir `closed` o `all`. `limit` es un alias de `size` para matching-service y mcp-tools.",
        "operationId": "list_jobs",
        "security": [
          { "bearerAuth": [] },
          { "serviceToken": [] }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filtro por estado. Default: active.",
            "required": false,
            "schema": { "$ref": "#/components/schemas/JobStatusFilter" }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Página 1-based.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Tamaño de página (1–200). Default: 5.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 5 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Alias de `size` para matching/mcp. Si viene, gana sobre `size`.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "post": {
        "tags": ["jobs"],
        "summary": "Crea una oferta (sólo empresa)",
        "description": "El `company_id` sale del `sub` del JWT. El `company_snapshot` se obtiene de auth-service. La oferta nace `active`, con `version=1`. Publica `job.created` a n8n (best-effort).",
        "operationId": "create_job",
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobCreate" },
              "examples": {
                "backend_junior": { "$ref": "#/components/examples/JobCreateExample" }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oferta creada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobOpportunity" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "description": "ID de la oferta (ej. `job-001`).",
          "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      ],
      "get": {
        "tags": ["jobs"],
        "summary": "Detalle de una oferta",
        "description": "Una oferta `closed` sólo es visible para la empresa dueña, un `admin` o el service token. Para el resto responde 404.",
        "operationId": "get_job",
        "security": [
          { "bearerAuth": [] },
          { "serviceToken": [] }
        ],
        "responses": {
          "200": {
            "description": "Oferta encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobOpportunity" },
                "examples": {
                  "job_001": { "$ref": "#/components/examples/JobOpportunityExample" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["jobs"],
        "summary": "Edita una oferta (sólo empresa dueña)",
        "description": "Los bloques enviados se reemplazan completos. Cada edición incrementa `version`. `status` sólo acepta `active` y sólo se usa para reabrir una oferta `closed`. Para cerrar se usa DELETE, no PATCH.",
        "operationId": "update_job",
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oferta actualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobOpportunity" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "tags": ["jobs"],
        "summary": "Cierra una oferta (sólo empresa dueña)",
        "description": "No borra físicamente: pasa `status` a `closed`, actualiza `updated_at` y suma `version`. Es idempotente: si ya estaba cerrada, responde 204.",
        "operationId": "close_job",
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "204": {
            "description": "Oferta cerrada (o ya estaba cerrada)"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/companies/me/searches": {
      "get": {
        "tags": ["companies"],
        "summary": "Búsquedas de la empresa autenticada",
        "description": "Lista las ofertas propias. Default: sólo `active` (AGENTS §4.3). `status=closed|all` habilita el filtro de HU-12 para gestionar el historial.",
        "operationId": "list_my_searches",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/JobStatusFilter" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 5 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Alias de `size`.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Búsquedas de la empresa",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "access_token de auth-service (RS256). El servicio valida firma, iss, aud, exp y role contra el JWKS."
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token",
        "description": "Token interno para matching-service, mcp-tools y n8n. Nunca se acepta como Bearer."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Regla de negocio violada",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Falta el token o es inválido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Rol incorrecto o recurso de otra empresa",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Oferta inexistente o cerrada para un tercero",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "ValidationError": {
        "description": "Body o query inválido (incluye UT-JOBS-01)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "UpstreamError": {
        "description": "auth-service o n8n no respondieron",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "examples": {
      "JobCreateExample": {
